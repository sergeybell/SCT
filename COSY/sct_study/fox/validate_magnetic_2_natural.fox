{ SCT study: single-point FR0 validation of sextupole currents }
INCLUDE 'magnetic_2';

PROCEDURE MCMCALC ALPHA0 ALPHA1;
  VARIABLE TMPALPHA 100;
  VARIABLE MCM1 1; VARIABLE MCM2 1;
  MCM MAP SPOS TMPALPHA;
  MCM1 := -TMPALPHA|(0&0&0&0&0&1);
  MCM2 := -TMPALPHA|(0&0&0&0&0&2);
  ALPHA0 := MCM1;
  ALPHA1 := MCM2;
ENDPROCEDURE;

PROCEDURE MAIN;
  VARIABLE CHROM_X 1; VARIABLE CHROM_Y 1;
  VARIABLE SGx1 1; VARIABLE SGy1 1; VARIABLE SGx2 1; VARIABLE SGy2 1;
  VARIABLE EB1 1; VARIABLE RF 1;
  VARIABLE MU 800; VARIABLE NBAR 800 3; VARIABLE MU0 1;
  VARIABLE MU_N_ARR 5000 1000; VARIABLE MU_TP 800 3;
  VARIABLE quad_Kx 1; VARIABLE quad_Ky 1; VARIABLE quad_Kz 1;
  VARIABLE GAMMA 1; VARIABLE BETA 1;
  VARIABLE ALPHA0 1; VARIABLE ALPHA1 1; VARIABLE ETA1 1;
  VARIABLE QX 1; VARIABLE QY 1;
  VARIABLE DNUX 1; VARIABLE DNUY 1; VARIABLE DNUZ 1;

  GAMMA := 1.143914;
  BETA := SQRT(1-1/(GAMMA*GAMMA));
  RF := 1;
  EB1 := 0.0;
  SGx1 := 0.0;
  SGx2 := 0.0;
  SGy1 := 0.0;
  SGy2 := 0.0;

  OV 3 2 1;
  SET_FOR_DEUTERONS_CHROM GAMMA;
  UM; LATTICE SGx1 SGy1 SGx2 SGy2 EB1 RF;
  TP MU_TP;
  CHROM_X := (MU_TP(1)|(0&0&0&0&1)) * (1+1/GAMMA);
  CHROM_Y := (MU_TP(2)|(0&0&0&0&1)) * (1+1/GAMMA);
  QX := CONS(MU_TP(1));
  QY := CONS(MU_TP(2));

  OV 3 3 0;
  SET_FOR_DEUTERONS GAMMA;
  UM; LATTICE SGx1 SGy1 SGx2 SGy2 EB1 RF;
  TSS MU NBAR 0;
  SR 0 0 0 0 0 0 0 0 1; SSR 0 0 1;
  SR 1*1E-3 0 0 0 0 0 0 0 1; SSR 0 0 1;
  SR 0 0 1*1E-3 0 0 0 0 0 1; SSR 0 0 1;
  SR 0 0 0 0 0 1*1E-4 0 0 1; SSR 0 0 1;
  GET_TUNE_ENSEMBLE MU_N_ARR;
  MU0 := CONS(MU);
  DNUX := MU_N_ARR(1)|3-MU0;
  DNUY := MU_N_ARR(1)|4-MU0;
  DNUZ := MU_N_ARR(1)|5-MU0;
  DAPEE MU 11 quad_Kx; DAPEE MU 33 quad_Ky; DAPEE MU 66 quad_Kz;
  MCMCALC ALPHA0 ALPHA1;
  ETA1 := ALPHA1+(3/2)*(BETA*BETA)/(GAMMA*GAMMA)-ALPHA0/(GAMMA*GAMMA)+1/(GAMMA*GAMMA*GAMMA*GAMMA);

  OPENF 3701 '../sct_study/dat/magnetic_2/validate_natural.dat' 'REPLACE';
  WRITE 3701 'tag=natural';
  WRITE 3701 'SGx1='&ST(SGx1);
  WRITE 3701 'SGx2='&ST(SGx2);
  WRITE 3701 'SGy1='&ST(SGy1);
  WRITE 3701 'SGy2='&ST(SGy2);
  WRITE 3701 'Qx='&ST(QX);
  WRITE 3701 'Qy='&ST(QY);
  WRITE 3701 'chrom_x='&ST(CHROM_X);
  WRITE 3701 'chrom_y='&ST(CHROM_Y);
  WRITE 3701 'MU_ref='&ST(MU0);
  WRITE 3701 'dnu_x='&ST(DNUX);
  WRITE 3701 'dnu_y='&ST(DNUY);
  WRITE 3701 'dnu_z='&ST(DNUZ);
  WRITE 3701 'quad_Kx='&ST(quad_Kx);
  WRITE 3701 'quad_Ky='&ST(quad_Ky);
  WRITE 3701 'quad_Kz='&ST(quad_Kz);
  WRITE 3701 'alpha0='&ST(ALPHA0);
  WRITE 3701 'alpha1='&ST(ALPHA1);
  WRITE 3701 'eta1='&ST(ETA1);
  CLOSEF 3701;
ENDPROCEDURE;

PROCEDURE RUN; MAIN; ENDPROCEDURE;
RUN; END;
