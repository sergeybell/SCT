{ SCT study: INJECT + multi-turn TR (FR0) }
INCLUDE 'magnetic_2';

PROCEDURE INJECT NUM PSI_DEG;
  VARIABLE X 100; VARIABLE I 1;
  VARIABLE PSI 1; VARIABLE SY 1; VARIABLE SZ 1;
  PSI := DEG2RAD(PSI_DEG);
  X := LINSPACE(-0.001, 0.001, NUM);
  SY := SIN(PSI); SZ := COS(PSI);
  SR 0 0 0 0 0 0 0 0 1; SSR 0 SY SZ;
  LOOP I 1 NUM;
    SR X|I 0 0 0 0 0 0 0 1; SSR 0 SY SZ;
  ENDLOOP;
  LOOP I 1 NUM;
    SR 0 0 X|I 0 0 0 0 0 1; SSR 0 SY SZ;
  ENDLOOP;
  LOOP I 1 NUM;
    SR 0 0 0 0 0 (X|I)*0.1 0 0 1; SSR 0 SY SZ;
  ENDLOOP;
ENDPROCEDURE;

PROCEDURE MAIN;
  VARIABLE SGx1 1; VARIABLE SGy1 1; VARIABLE SGx2 1; VARIABLE SGy2 1;
  VARIABLE EB1 1; VARIABLE RF 1;
  VARIABLE GAMMA 1;
  VARIABLE NTURN 1; VARIABLE PNUM 1; VARIABLE PSI0 1;

  GAMMA := 1.143914;
  RF := 1; EB1 := 0.0;
  SGx1 := 0.0176; SGx2 := 0.0176; SGy1 := -0.0264; SGy2 := 0.0;
  NTURN := 2000;
  PNUM := 9;
  PSI0 := 90.0;

  OV 3 3 0;
  SET_FOR_DEUTERONS GAMMA;
  UM; LATTICE SGx1 SGy1 SGx2 SGy2 EB1 RF;

  INJECT PNUM PSI0;
  OPENF 99 '../sct_study/dat/magnetic_2/track_ctrl_xi_x_full_PRAY.dat' 'REPLACE';
  PRAY 99; CLOSEF 99;
  OPENF 772 '../sct_study/dat/magnetic_2/track_ctrl_xi_x_full_TRPRAY.dat' 'REPLACE';
  OPENF 893 '../sct_study/dat/magnetic_2/track_ctrl_xi_x_full_TRPSPI.dat' 'REPLACE';
  TRPRAY 772; TRPSPI 893;
  TR NTURN NINT(NTURN*0.05) -1 -3 1.2 1.2 0 0 -12;
  CLOSEF 772; CLOSEF 893;
  CR;
ENDPROCEDURE;

PROCEDURE RUN; MAIN; ENDPROCEDURE;
RUN; END;
