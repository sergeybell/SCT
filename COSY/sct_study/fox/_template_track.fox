{ SCT study: INJECT + multi-turn TR (FR0) }
INCLUDE '{{STEM}}';

PROCEDURE INJECT NUM PSI_DEG;
  VARIABLE X 100; VARIABLE I 1;
  VARIABLE PSI 1; VARIABLE SY 1; VARIABLE SZ 1;
  PSI := DEG2RAD(PSI_DEG);
  X := LINSPACE(-{{XAMP}}, {{XAMP}}, NUM);
  SY := SIN(PSI); SZ := COS(PSI);
  SR 0 0 0 0 0 0 0 0 1; SSR 0 SY SZ;
  LOOP I 1 NUM;
    SR X|I 0 0 0 0 0 0 0 1; SSR 0 SY SZ;
  ENDLOOP;
  LOOP I 1 NUM;
    SR 0 0 X|I 0 0 0 0 0 1; SSR 0 SY SZ;
  ENDLOOP;
  LOOP I 1 NUM;
    SR 0 0 0 0 0 (X|I)*{{DSCALE}} 0 0 1; SSR 0 SY SZ;
  ENDLOOP;
ENDPROCEDURE;

PROCEDURE MAIN;
  VARIABLE SGx1 1; VARIABLE SGy1 1; VARIABLE SGx2 1; VARIABLE SGy2 1;
  VARIABLE EB1 1; VARIABLE RF 1;
  VARIABLE GAMMA 1;
  VARIABLE NTURN 1; VARIABLE PNUM 1; VARIABLE PSI0 1;

  GAMMA := {{GAMMA}};
  RF := 1; EB1 := 0.0;
  SGx1 := {{SGX1}}; SGx2 := {{SGX2}}; SGy1 := {{SGY1}}; SGy2 := 0.0;
  NTURN := {{NTURN}};
  PNUM := {{PNUM}};
  PSI0 := {{PSI}};

  OV 3 3 0;
  SET_FOR_DEUTERONS GAMMA;
  UM; LATTICE SGx1 SGy1 SGx2 SGy2 EB1 RF;

  INJECT PNUM PSI0;
  OPENF 99 '{{OUTPRAY}}' 'REPLACE';
  PRAY 99; CLOSEF 99;
  OPENF 772 '{{OUTTRPRAY}}' 'REPLACE';
  OPENF 893 '{{OUTTRPSPI}}' 'REPLACE';
  TRPRAY 772; TRPSPI 893;
  TR NTURN NINT(NTURN*{{SAVEFRAC}}) -1 -3 1.2 1.2 0 0 -12;
  CLOSEF 772; CLOSEF 893;
  CR;
ENDPROCEDURE;

PROCEDURE RUN; MAIN; ENDPROCEDURE;
RUN; END;
