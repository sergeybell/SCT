{ SCT study: working point Qx,Qy, spin tune at given currents }
INCLUDE 'magnetic_2';

PROCEDURE MAIN;
  VARIABLE SGx1 1; VARIABLE SGy1 1; VARIABLE SGx2 1; VARIABLE SGy2 1;
  VARIABLE EB1 1; VARIABLE RF 1;
  VARIABLE MU 800; VARIABLE NBAR 800 3; VARIABLE MU0 1;
  VARIABLE MU_TP 800 3;
  VARIABLE GAMMA 1; VARIABLE QX 1; VARIABLE QY 1;
  VARIABLE GG 1;

  GAMMA := 1.143914;
  RF := 1; EB1 := 0.0;
  SGx1 := 0.004110603226596334; SGx2 := -0.003183980136620862; SGy1 := -0.004030542798297506; SGy2 := 0.0;

  OV 3 2 1;
  SET_FOR_DEUTERONS_CHROM GAMMA;
  UM; LATTICE SGx1 SGy1 SGx2 SGy2 EB1 RF;
  TP MU_TP;
  QX := CONS(MU_TP(1));
  QY := CONS(MU_TP(2));

  OV 3 3 0;
  SET_FOR_DEUTERONS GAMMA;
  UM; LATTICE SGx1 SGy1 SGx2 SGy2 EB1 RF;
  TSS MU NBAR 0;
  MU0 := CONS(MU);
  GG := GAMMA*(-0.142987);

  OPENF 3702 '../sct_study/dat/magnetic_2/wp_Istar.dat' 'REPLACE';
  WRITE 3702 'tag=Istar';
  WRITE 3702 'SGx1='&ST(SGx1);
  WRITE 3702 'SGx2='&ST(SGx2);
  WRITE 3702 'SGy1='&ST(SGy1);
  WRITE 3702 'Qx='&ST(QX);
  WRITE 3702 'Qy='&ST(QY);
  WRITE 3702 'NU_s='&ST(MU0);
  WRITE 3702 'gammaG='&ST(GG);
  CLOSEF 3702;
ENDPROCEDURE;

PROCEDURE RUN; MAIN; ENDPROCEDURE;
RUN; END;
