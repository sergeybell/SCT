{ ************************************************************ }
{ COSY Infinity Lattice Converter                              }
{ Purpose: Auto-generation of maps (SMAPS) for Twiss functions }
{ Author: Kolokolchikov S.                                     }
{ Date: 2026-04-13 19:04:18                        }
{ Input file: C:/GIT_REPOS/SCT/COSY/src/electrostatic.fox      }
{ Output file: C:/GIT_REPOS/SCT/COSY/src/electrostatic_maps.fox }
{ ************************************************************ }

INCLUDE 'header';
{LATTICE}
PROCEDURE LATTICE SEXTGx1 SEXTGy1 SEXTGx2 SEXTGy2 EB1 RFFLAG MAPARR SPNRARR;
  VARIABLE VRF 1 1 1;
  VARIABLE FREQ 1;
  VARIABLE HNUM 1;
  VARIABLE I 1;
  VARIABLE LEN_S 1; VARIABLE A 1; VARIABLE LEN_S_1 1;
  VARIABLE EBE 1; VARIABLE BBE 1;
  VARIABLE QF0 1;
  VARIABLE QFA1 1; VARIABLE QDA1 1;
  VARIABLE QFA2 1; VARIABLE QDA2 1;
  VARIABLE GAMMA 1;
  VARIABLE Lf 1;
  VARIABLE Ld 1;
  VARIABLE Lfs 1;
  VARIABLE Lds 1;
  VARIABLE SF1 1; VARIABLE SF2 1; VARIABLE SD 1; VARIABLE SD1 1;

  {LATTICE PARAMETERS}
  EBE := EB1;

  A := 0.05; LEN_S := 0.15;

{SFP, SDP - betatron chrom}

  SF1 := SEXTGx1; SF2 := SEXTGx2; SD := SEXTGy1; SD1 := SEXTGy2;

{FS for E=232.79774 invert cilindr}

	Lf:=(-6.1863*A*A*1E+4)*1/2;
	Ld:=(6.7855*A*A*1E+4)*1/2;
	Lfs:=(-7.11305*A*A*1E+4)*1/2;
	Lds:=(7.9336*A*A*1E+4)*1/2;

  {SETTING RF PARAMETERS}
  HNUM := 66;
  VRF(1, 1) := 100/HNUM; {RF Voltage [kV]}
  FREQ := HNUM*REVFREQ(fACCLEN(1)); {RF Frequency}

 { WRITE 6 '********************************************';
  WRITE 6 '*      FS NICA BYPASS 7 NOW 2022           *';
  WRITE 6 '********************************************';

  WRITE 6 'REVOLUTION FREQUENCY: '&ST(REVFREQ(fACCLEN(1))/1E6)&' MHZ';
  WRITE 6 'RF FREQUENCY: '&ST(FREQ/1E6)&' MHZ';}

  UM; CR;
  IF RFFLAG=1; RF VRF 0 FREQ 0 0.05;
    { WRITE 6 'INSERTING RF...'; }
    { WRITE 6 'RF MAP(6):' MAP(6); }
  ENDIF; {inserted by @AA}

{BEGIN PERIOD}

UM; EQ 0.5 Lds A; {Lds} SMAPS 1 MAPARR SPNRARR;
UM; DL 5.985;  SMAPS 2 MAPARR SPNRARR;
UM; EQ 0.5 Lfs A; {Lfs} SMAPS 3 MAPARR SPNRARR;

UM; EQ 0.5 Lf A; {Lf} SMAPS 4 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 5 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 6 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 7 MAPARR SPNRARR;
UM; EQ 2*0.5 Ld A; {2 Ld} SMAPS 8 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 9 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 10 MAPARR SPNRARR;
UM; DL 0.65; {OD2} SMAPS 11 MAPARR SPNRARR;
UM; EQ 2*0.5 Lf A; {2 Lf} SMAPS 12 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 13 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 14 MAPARR SPNRARR;
UM; DL 0.25; {OD2} SMAPS 15 MAPARR SPNRARR;
UM; MH 0.15 SF1 0.05; {SF1} SMAPS 16 MAPARR SPNRARR;
UM; DL 0.25; {OD1} SMAPS 17 MAPARR SPNRARR;
UM; EQ 2*0.5 Ld A; {2 Ld} SMAPS 18 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 19 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 20 MAPARR SPNRARR;
UM; DL 0.25; {OD2} SMAPS 21 MAPARR SPNRARR;
UM; MH 0.15 SD 0.05; {SD} SMAPS 22 MAPARR SPNRARR;
UM; DL 0.25; {OD1} SMAPS 23 MAPARR SPNRARR;
UM; EQ 2*0.5 Lf A; {2 Lf} SMAPS 24 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 25 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 26 MAPARR SPNRARR;
UM; DL 0.25; {OD2} SMAPS 27 MAPARR SPNRARR;
UM; MH 0.15 SF2 0.05; {SF2} SMAPS 28 MAPARR SPNRARR;
UM; DL 0.25; {OD1} SMAPS 29 MAPARR SPNRARR;
UM; EQ 2*0.5 Ld A; {2 Ld} SMAPS 30 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 31 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 32 MAPARR SPNRARR;
UM; DL 0.25; {OD2} SMAPS 33 MAPARR SPNRARR;
UM; MH 0.15 SD 0.05; {SD} SMAPS 34 MAPARR SPNRARR;
UM; DL 0.25; {OD1} SMAPS 35 MAPARR SPNRARR;
UM; EQ 2*0.5 Lf A; {2 Lf} SMAPS 36 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 37 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 38 MAPARR SPNRARR;
UM; DL 0.25; {OD2} SMAPS 39 MAPARR SPNRARR;
UM; MH 0.15 SF1 0.05; {SF1} SMAPS 40 MAPARR SPNRARR;
UM; DL 0.25; {OD1} SMAPS 41 MAPARR SPNRARR;
UM; EQ 2*0.5 Ld A; {2 Ld} SMAPS 42 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 43 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 44 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 45 MAPARR SPNRARR;
UM; EQ 2*0.5 Lf A; {2 Lf} SMAPS 46 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 47 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 48 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 49 MAPARR SPNRARR;
UM; EQ 2*0.5 Ld A; {2 Ld} SMAPS 50 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 51 MAPARR SPNRARR;
UM; ED 4.685 EBE 0; {R1} SMAPS 52 MAPARR SPNRARR;
UM; DL 0.65;  SMAPS 53 MAPARR SPNRARR;
UM; EQ 0.5 Lf A; {Lf} SMAPS 54 MAPARR SPNRARR;

UM; EQ 0.5 Lfs A; {Lfs} SMAPS 55 MAPARR SPNRARR;
UM; DL 5.985;  SMAPS 56 MAPARR SPNRARR;
UM; EQ 0.5 Lds A; {Lds} SMAPS 57 MAPARR SPNRARR;

ENDPROCEDURE; {FSp SETUP}

SAVE 'electrostatic_maps';





