INCLUDE 'header';

PROCEDURE LATTICE SEXTGx1 SEXTGy1 SEXTGx2 SEXTGy2 EB1 RFFLAG;
 VARIABLE VRF 1 1 1; VARIABLE FREQ 1; VARIABLE HNUM 1; VARIABLE I 1;
 VARIABLE A 1; VARIABLE LEN_S 1; VARIABLE LEN_S_1 1; VARIABLE EBE 1; VARIABLE L_O2_SEXT 1;
 VARIABLE QF 1;
 VARIABLE QD 1;
 VARIABLE QF1 1;
 VARIABLE QD1 1;
 VARIABLE L_BM 1;
 VARIABLE ANG_BM 1;
 VARIABLE L_OBM 1;
 VARIABLE L_O2 1;
 VARIABLE L_QF 1;
 VARIABLE L_QD 1;
 VARIABLE L_QF1 1;
 VARIABLE L_QD1 1;
 VARIABLE SF1 1; VARIABLE SF2 1; VARIABLE SD 1; VARIABLE SD1 1;

 {LATTICE PARAMETERS}
 EBE := EB1; A := 0.05; LEN_S_1 := 0.000001;
 SF1 := SEXTGx1; SF2 := SEXTGx2; SD := SEXTGy1; SD1 := SEXTGy2;

 {ELEMENT VALUES FROM MADX}
 L_BM := 5.3294148;
 ANG_BM := 0.3926990754;
 L_OBM := 5.3294148;
 L_O2 := 0.25;
 L_QF := 0.21;
 QF := 0.4803696115;
 L_QD := 0.21;
 QD := -0.5393371387;
 L_QF1 := 0.2;
 QF1 := 0.560680507;
 L_QD1 := 0.2;
 QD1 := -0.5609106242;
 
 L_O2_SEXT := 0.15;
 LEN_S := 0.1;

 {SETTING RF PARAMETERS}
 HNUM := 66; VRF(1, 1) := 100/HNUM; FREQ := HNUM*REVFREQ(fACCLEN(1));
 UM; CR; IF RFFLAG=1; RF VRF 0 FREQ 0 0.05; ENDIF;

 {BEGIN LATTICE}
 QUAD L_QF A QF ; {QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF A QF ; {2QF}
 MH LEN_S SF1 0.05; {SF1}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2QD}
 MH LEN_S SD 0.05; {SD}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF A QF ; {2QF}
 MH LEN_S SF2 0.05; {SF2}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2QD}
 MH LEN_S SD 0.05; {SD}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF A QF ; {2QF}
 MH LEN_S SF1 0.05; {SF1}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 QUAD L_QF1 A QF1 ; {QF1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD1 A QD1 ; {2QD1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF1 A QF1 ; {2QF1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD1 A QD1 ; {2QD1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF1 A QF1 ; {2QF1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD1 A QD1 ; {2QD1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD L_QF1 A QF1 ; {QF1}

 QUAD L_QF A QF ; {QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF A QF ; {2QF}
 MH LEN_S SF1 0.05; {SF1}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2QD}
 MH LEN_S SD 0.05; {SD}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF A QF ; {2QF}
 MH LEN_S SF2 0.05; {SF2}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2QD}
 MH LEN_S SD 0.05; {SD}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF A QF ; {2QF}
 MH LEN_S SF1 0.05; {SF1}
 DL L_O2_SEXT ; {O2_SEXT}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 QUAD L_QF1 A QF1 ; {QF1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD1 A QD1 ; {2QD1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF1 A QF1 ; {2QF1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD1 A QD1 ; {2QD1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF1 A QF1 ; {2QF1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD1 A QD1 ; {2QD1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD L_QF1 A QF1 ; {QF1}

ENDPROCEDURE;

