INCLUDE 'header';

PROCEDURE LATTICE SEXTGx1 SEXTGy1 SEXTGx2 SEXTGy2 EB1 RFFLAG;
 VARIABLE VRF 1 1 1; VARIABLE FREQ 1; VARIABLE HNUM 1; VARIABLE I 1;
 VARIABLE A 1; VARIABLE EBE 1; VARIABLE BBE 1;
 VARIABLE L_BM 1;
 VARIABLE ANG_BM 1;
 VARIABLE L_O1 1;
 VARIABLE L_O3 1;
 VARIABLE L_O2 1;
 VARIABLE L_O4 1;
 VARIABLE L_OSF 1;
 VARIABLE L_OSD 1;
 VARIABLE L_QF 1;
 VARIABLE QF 1;
 VARIABLE L_QF1 1;
 VARIABLE QF1 1;
 VARIABLE L_QD1 1;
 VARIABLE QD1 1;
 VARIABLE L_QD 1;
 VARIABLE QD 1;
 VARIABLE LEN_S 1;
 VARIABLE SF1 1;
 VARIABLE LEN_S 1;
 VARIABLE SF2 1;
 VARIABLE LEN_S 1;
 VARIABLE SD 1; VARIABLE SD1 1;
 VARIABLE L_RA 1;

 {LATTICE PARAMETERS}
 EBE := EB1; A := 0.05; LEN_S := 0.12;
 SF1 := SEXTGx1; SF2 := SEXTGx2; SD := SEXTGy1; SD1 := SEXTGy2;

 {ELEMENT VALUES FROM MADX}
 L_BM := 1.7764716;
 ANG_BM := 0.1308996918;
 L_O1 := 0.13+0.1;
 L_O3 := 2.82;
 L_O2 := 0.25;
 L_O4 := 0.45;
 L_OSF := 0.1;
 L_OSD := 0.1;
 L_QF := 0.21;
 QF := 0.9893741418;
 L_QF1 := 0.2;
 QF1 := 1.399065275;
 L_QD1 := 0.2;
 QD1 := -1.386374025;
 L_QD := 0.2;
 QD := -1.015274118;
 L_RA := 3.27;

 {SETTING RF PARAMETERS}
 HNUM := 1; VRF(1, 1) := 1; FREQ := HNUM*REVFREQ(fACCLEN(1));
 UM; CR; IF RFFLAG=1; RF VRF 0 FREQ 0 0.05; ENDIF;

 {BEGIN LATTICE}
LOOP I 1 8;
 QUAD L_QD 0 QD ; {QD}
 WIEN L_RA BBE EBE 0; {WF}
 QUAD 2*L_QF1 0 QF1 ; {2 QF1}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O4 ; {O4}
 QUAD 2*L_QD1 0 QD1 ; {2 QD1}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O1 ; {O1}
 MH LEN_S SF1 A ; {SF1}
 DL L_OSF ; {OSF}
 QUAD 2*L_QF1 0 QF1 ; {2 QF1}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O1 ; {O1}
 MH LEN_S SD A ; {SD}
 DL L_OSD ; {OSD}
 QUAD 2*L_QD1 0 QD1 ; {2 QD1}
 DL L_O3 ; {O3}
 QUAD L_QF 0 QF ; {QF}
 DL L_OSF ; {OSF}
 MH LEN_S SF2 A ; {SF2}
 DL L_OSF ; {OSF}
 QUAD L_QF 0 QF ; {QF}
 DL L_O3 ; {O3}
 QUAD 2*L_QD1 0 QD1 ; {2 QD1}
 DL L_OSD ; {OSD}
 MH LEN_S SD A ; {SD}
 DL L_O1 ; {O1}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF1 0 QF1 ; {2 QF1}
 DL L_OSF ; {OSF}
 MH LEN_S SF1 A ; {SF1}
 DL L_O1 ; {O1}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD1 0 QD1 ; {2 QD1}
 DL L_O4 ; {O4}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QF1 0 QF1 ; {2 QF1}
 WIEN L_RA BBE EBE 0; {WF}
 QUAD L_QD 0 QD ; {QD}
ENDLOOP;
ENDPROCEDURE;
SAVE 'seq_Nuclotron_8';