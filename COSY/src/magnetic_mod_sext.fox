 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QD A QD ; {QD}
 MH LEN_S_1 SD 0.05; {SD}
 QUAD L_QD A QD ; {QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 MH LEN_S_1 SF2 0.05; {SF2}
 QUAD L_QF A QF ; {QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QD A QD ; {QD}
 MH LEN_S_1 SD 0.05; {SD}
 QUAD L_QD A QD ; {QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 MH LEN_S_1 SF1 0.05; {SF1}
 QUAD L_QF A QF ; {QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QD A QD ; {QD}
 QUAD L_QD A QD ; {QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 QUAD L_QF1 A QF1 ; {QF1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD L_QD1 A QD1 ; {QD1}
 QUAD L_QD1 A QD1 ; {QD1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD L_QF1 A QF1 ; {QF1}
  
 QUAD L_QF A QF ; {QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QD A QD ; {QD}
 QUAD L_QD A QD ; {QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 MH LEN_S_1 SF1 0.05; {SF1}
 QUAD L_QF A QF ; {QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QD A QD ; {QD}
 MH LEN_S_1 SD 0.05; {SD}
 QUAD L_QD A QD ; {QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 MH LEN_S_1 SF2 0.05; {SF2}
 QUAD L_QF A QF ; {QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QD A QD ; {QD}
 MH LEN_S_1 SD 0.05; {SD}
 QUAD L_QD A QD ; {QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 MH LEN_S_1 SF1 0.05; {SF1}
 QUAD L_QF A QF ; {QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QD A QD ; {QD}
 QUAD L_QD A QD ; {QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 QUAD L_QF1 A QF1 ; {QF1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD L_QD1 A QD1 ; {QD1}
 QUAD L_QD1 A QD1 ; {QD1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD L_QF1 A QF1 ; {QF1}

ENDPROCEDURE;

