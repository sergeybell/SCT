INCLUDE 'header';
{LATTICE}
PROCEDURE LATTICE SEXTGx1 SEXTGy1 SEXTGx2 SEXTGy2 EB1 RFFLAG;
  VARIABLE VRF 1 1 1;
  VARIABLE FREQ 1;
  VARIABLE HNUM 1;
  VARIABLE I 1;
  VARIABLE LEN_S 1; VARIABLE A 1; VARIABLE LEN_S_1 1;
  VARIABLE EBE 1; VARIABLE BBE 1;
  VARIABLE QF0 1;
  VARIABLE QFA1 1; VARIABLE QDA1 1;
  VARIABLE QFA2 1; VARIABLE QDA2 1;
  VARIABLE GAMMA 1;
  VARIABLE Lf 1;
  VARIABLE Ld 1;
  VARIABLE Lfs 1;
  VARIABLE Lds 1;
  VARIABLE SF1 1; VARIABLE SF2 1; VARIABLE SD 1; VARIABLE SD1 1;

  {LATTICE PARAMETERS}
  EBE := EB1;

  A := 0.05; LEN_S := 0.15;

{SFP, SDP - betatron chrom}

  SF1 := SEXTGx1; SF2 := SEXTGx2; SD := SEXTGy1; SD1 := SEXTGy2;

{FS for E=232.79774 invert cilindr}

	Lf:=(-6.1863*A*A*1E+4)*1/2;
	Ld:=(6.7855*A*A*1E+4)*1/2;
	Lfs:=(-7.11305*A*A*1E+4)*1/2;
	Lds:=(7.9336*A*A*1E+4)*1/2;

  {SETTING RF PARAMETERS}
  HNUM := 66;
  VRF(1, 1) := 100/HNUM; {RF Voltage [kV]}
  FREQ := HNUM*REVFREQ(fACCLEN(1)); {RF Frequency}

 { WRITE 6 '********************************************';
  WRITE 6 '*      FS NICA BYPASS 7 NOW 2022           *';
  WRITE 6 '********************************************';

  WRITE 6 'REVOLUTION FREQUENCY: '&ST(REVFREQ(fACCLEN(1))/1E6)&' MHZ';
  WRITE 6 'RF FREQUENCY: '&ST(FREQ/1E6)&' MHZ';}

  UM; CR;
  IF RFFLAG=1; RF VRF 0 FREQ 0 0.05;
    { WRITE 6 'INSERTING RF...'; }
    { WRITE 6 'RF MAP(6):' MAP(6); }
  ENDIF; {inserted by @AA}

LOOP I 1 5;
{BEGIN PERIOD}

EQ 0.5 Lds A; {Lds}
DL 5.985;
EQ 0.5 Lfs A; {Lfs}

EQ 0.5 Lf A; {Lf}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.65;
EQ 2*0.5 Ld A; {2 Ld}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.65; {OD2}
EQ 2*0.5 Lf A; {2 Lf}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.25; {OD2}
MH 0.15 SF1 0.05; {SF1}
DL 0.25; {OD1}
EQ 2*0.5 Ld A; {2 Ld}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.25; {OD2}
MH 0.15 SD 0.05; {SD}
DL 0.25; {OD1}
EQ 2*0.5 Lf A; {2 Lf}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.25; {OD2}
MH 0.15 SF2 0.05; {SF2}
DL 0.25; {OD1}
EQ 2*0.5 Ld A; {2 Ld}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.25; {OD2}
MH 0.15 SD 0.05; {SD}
DL 0.25; {OD1}
EQ 2*0.5 Lf A; {2 Lf}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.25; {OD2}
MH 0.15 SF1 0.05; {SF1}
DL 0.25; {OD1}
EQ 2*0.5 Ld A; {2 Ld}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.65;
EQ 2*0.5 Lf A; {2 Lf}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.65;
EQ 2*0.5 Ld A; {2 Ld}
DL 0.65;
ED 4.685 EBE 0; {R1}
DL 0.65;
EQ 0.5 Lf A; {Lf}

EQ 0.5 Lfs A; {Lfs}
DL 5.985; 
EQ 0.5 Lds A; {Lds}

ENDLOOP;

ENDPROCEDURE; {FSp SETUP}

SAVE 'electrostatic';





