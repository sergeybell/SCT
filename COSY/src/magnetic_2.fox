INCLUDE 'header';

PROCEDURE LATTICE SEXTGx1 SEXTGy1 SEXTGx2 SEXTGy2 EB1 RFFLAG;
 VARIABLE I 1;
 VARIABLE A 1;
 VARIABLE L_BM 1;
 VARIABLE ANG_BM 1;
 VARIABLE L_OBM 1;
 VARIABLE L_OS1 1;
 VARIABLE L_OS2 1;
 VARIABLE L_QD 1;
 VARIABLE QD 1;
 VARIABLE L_QD1 1;
 VARIABLE QD1 1;
 VARIABLE L_QF 1;
 VARIABLE QF 1;
 VARIABLE L_QF1 1;
 VARIABLE QF1 1;
 VARIABLE L_SD 1;
 VARIABLE SD 1;
 VARIABLE L_SF1 1;
 VARIABLE SF1 1;
 VARIABLE L_SF2 1;
 VARIABLE SF2 1;

 {LATTICE PARAMETERS}
 A := 0.05;

 {ELEMENT VALUES FROM OPTIM}
 { Beam: E=270 MeV, M=1876.544 MeV, Brho=3.476489686 T*m }
 L_BM := 5.3294148;
 ANG_BM := 0.3926990754;
 L_OBM := 5.3294148;
 L_OS1 := 0.12;
 L_OS2 := 0.06;
 L_QD := 0.21;
 QD := -0.580585643;
 L_QD1 := 0.21;
 QD1 := -0.5565959271;
 L_QF := 0.21;
