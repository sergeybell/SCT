 L_SD := 0.12;
 SD := 0;
 L_SF1 := 0.12;
 SF1 := 0;
 L_SF2 := 0.12;
 SF2 := 0;

 {BEGIN LATTICE}
 LOOP I 1 1;
  DL L_OS2 ; {OS2}
  QUAD L_QF A QF ; {QF}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QD A QD ; {QD}
  DL L_OS1 ; {OS1}
  QUAD L_QD A QD ; {QD}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QF A QF ; {QF}
  MH L_SF2 SF2 A ; {SF2}
  QUAD L_QF A QF ; {QF}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QD A QD ; {QD}
  MH L_SD SD A ; {SD}
  QUAD L_QD A QD ; {QD}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QF A QF ; {QF}
  MH L_SF1 SF1 A ; {SF1}
  QUAD L_QF A QF ; {QF}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QD A QD ; {QD}
  MH L_SD SD A ; {SD}
  QUAD L_QD A QD ; {QD}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QF A QF ; {QF}
  MH L_SF2 SF2 A ; {SF2}
  QUAD L_QF A QF ; {QF}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QD A QD ; {QD}
  DL L_OS1 ; {OS1}
  QUAD L_QD A QD ; {QD}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QF A QF ; {QF}
  DL L_OS2 ; {OS2}
  DL L_OS2 ; {OS2}
  QUAD L_QF1 A QF1 ; {QF1}
  DL L_OBM ; {OBM}
  QUAD L_QD1 A QD1 ; {QD1}
  DL L_OS1 ; {OS1}
  QUAD L_QD1 A QD1 ; {QD1}
  DL L_OBM ; {OBM}
  QUAD L_QF1 A QF1 ; {QF1}
  DL L_OS2 ; {OS2}
  DL L_OS2 ; {OS2}
  QUAD L_QF A QF ; {QF}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QD A QD ; {QD}
  DL L_OS1 ; {OS1}
  QUAD L_QD A QD ; {QD}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QF A QF ; {QF}
  MH L_SF2 SF2 A ; {SF2}
  QUAD L_QF A QF ; {QF}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QD A QD ; {QD}
  MH L_SD SD A ; {SD}
  QUAD L_QD A QD ; {QD}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QF A QF ; {QF}
  MH L_SF1 SF1 A ; {SF1}
  QUAD L_QF A QF ; {QF}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QD A QD ; {QD}
  MH L_SD SD A ; {SD}
  QUAD L_QD A QD ; {QD}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QF A QF ; {QF}
  MH L_SF2 SF2 A ; {SF2}
  QUAD L_QF A QF ; {QF}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QD A QD ; {QD}
  DL L_OS1 ; {OS1}
  QUAD L_QD A QD ; {QD}
  SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
  QUAD L_QF A QF ; {QF}
  DL L_OS2 ; {OS2}
  DL L_OS2 ; {OS2}
  QUAD L_QF1 A QF1 ; {QF1}
  DL L_OBM ; {OBM}
  QUAD L_QD1 A QD1 ; {QD1}
  DL L_OS1 ; {OS1}
  QUAD L_QD1 A QD1 ; {QD1}
  DL L_OBM ; {OBM}
  QUAD L_QF1 A QF1 ; {QF1}
  DL L_OS2 ; {OS2}
 ENDLOOP;
ENDPROCEDURE;
SAVE 'magnetic_2';
